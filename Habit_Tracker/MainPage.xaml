<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Habit_Tracker"
             x:Class="Habit_Tracker.MainPage"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <DataTemplate x:Key="EmptyTemplate" x:DataType="models:Habit">
            <StackLayout HorizontalOptions="Center"
                         VerticalOptions="Center"
                         Padding="50">
                <Label Text="У вас пока нет привычек"
                       FontFamily="RobotoLight"
                       TextColor="{StaticResource InactiveGrey}"
                       FontSize="18"
                       HorizontalOptions="Center"/>
                <Label Text="Добавьте первую привычку, нажав кнопку ниже"
                       FontFamily="RobotoLight"
                       TextColor="{StaticResource InactiveGrey}"
                       FontSize="14"
                       HorizontalOptions="Center"/>
            </StackLayout>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="90, *, Auto, Auto"
          Padding="30,0">

        <!-- Верхняя панель -->
        <Grid Grid.Row="0"
              HeightRequest="90"
              WidthRequest="412"
              HorizontalOptions="Center"
              BackgroundColor="{StaticResource PanelWhite}">

            <Label Text="Добро пожаловать!"
                   FontFamily="RobotoRegular"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TextColor="{StaticResource ActivePurple}"
                   FontSize="22"/>

        </Grid>

        <!-- Центральная часть - список привычек -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout>
                <Label Text="Список привычек"
                       FontFamily="RobotoRegular"
                       HorizontalOptions="Center"
                       TextColor="black"
                       FontSize="20"
                       Margin="0,20,0,20"/>

                <!-- Коллекция привычек -->
                <CollectionView x:Name="HabitsCollectionView"
                                EmptyView="У вас пока нет привычек. Добавьте первую!"
                                EmptyViewTemplate="{StaticResource EmptyTemplate}">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Habit">
                            <Grid Padding="15,10"
                                  ColumnDefinitions="*, Auto, Auto"
                                  BackgroundColor="{StaticResource PanelWhite}"
                                  Margin="0,0,0,10">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Название привычки -->
                                <Label Grid.Row="0"
                                       Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontFamily="RobotoRegular"
                                       TextColor="Black"
                                       FontSize="18"
                                       VerticalOptions="Center"/>

                                <!-- Частота -->
                                <Label Grid.Row="1"
                                       Grid.Column="0"
                                       Text="{Binding Frequency}"
                                       FontFamily="RobotoLight"
                                       TextColor="{StaticResource InactiveGrey}"
                                       FontSize="14"
                                       VerticalOptions="Center"/>

                                <!-- Время напоминания -->
                                <Label Grid.Row="1"
                                       Grid.Column="1"
                                       Text="{Binding DisplayTime}"
                                       FontFamily="RobotoLight"
                                       TextColor="{StaticResource InactiveGrey}"
                                       FontSize="14"
                                       VerticalOptions="Center"
                                       Margin="0,0,10,0"/>

                                <!-- Кнопка выполнения -->
                                <Button Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="2"
                                        BackgroundColor="Transparent"
                                        BorderWidth="0"
                                        Clicked="OnHabitDeleteClicked">
                                    <Button.ImageSource>
                                        <FontImageSource Glyph="&#xE5CA;"
                                                         FontFamily="MaterialDesignIcons"
                                                         Color="{StaticResource ActivePurple}"
                                                         Size="30"/>
                                    </Button.ImageSource>
                                </Button>

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Кнопка добавления привычки -->
        <Button Grid.Row="2"
                Text="Добавить новую привычку"
                FontFamily="RobotoLight"
                FontSize="20"
                BackgroundColor="{StaticResource PanelWhite}"
                TextColor="{StaticResource ActivePurple}"
                CornerRadius="10"
                HeightRequest="60"
                WidthRequest="293"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Margin="0,0,0,25"
                Clicked="OnAddHabitClicked">

            <Button.Shadow>
                <Shadow Brush="#40000000"
                        Offset="0,5"
                        Radius="2"
                        Opacity="0.3"/>
            </Button.Shadow>
        </Button>

        <!-- Панель навигации -->
        <Grid Grid.Row="3"
              BackgroundColor="{StaticResource PanelWhite}"
              HeightRequest="90"
              WidthRequest="412"
              Padding="20,0"
              ColumnDefinitions="*, *, *">

            <!-- Первая иконка -->
            <Button Grid.Column="0"
                    BackgroundColor="Transparent"
                    BorderWidth="0">
                <Button.ImageSource>
                    <FontImageSource Glyph="&#xE80F;"
                                     FontFamily="MaterialDesignIcons"
                                     Color="{StaticResource InactiveGrey}"
                                     Size="40"/>
                </Button.ImageSource>
            </Button>

            <!-- Вторая иконка -->
            <Button Grid.Column="1"
                    BackgroundColor="Transparent"
                    BorderWidth="0">
                <Button.ImageSource>
                    <FontImageSource Glyph="&#xE9D2;"
                                     FontFamily="MaterialDesignIcons"
                                     Color="{StaticResource ActivePurple}"
                                     Size="40"/>
                </Button.ImageSource>
            </Button>

            <!-- Третья иконка -->
            <Button Grid.Column="2"
                    BackgroundColor="Transparent"
                    BorderWidth="0">
                <Button.ImageSource>
                    <FontImageSource Glyph="&#xE853;"
                                     FontFamily="MaterialDesignIcons"
                                     Color="{StaticResource InactiveGrey}"
                                     Size="40"/>
                </Button.ImageSource>
            </Button>

        </Grid>

    </Grid>

</ContentPage>