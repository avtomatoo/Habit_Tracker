<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Habit_Tracker.MainPage">

    <Grid RowDefinitions="90, *, Auto, Auto"
          Padding="30,0">

        <!-- Верхняя панель 393x90 -->
        <Grid Grid.Row="0"
              HeightRequest="90"
              WidthRequest="412"
              HorizontalOptions="Center"
              BackgroundColor="{StaticResource PanelWhite}">

            <Label Text="Добро пожаловать, Имя!"
                   FontFamily="RobotoRegular"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TextColor="{StaticResource ActivePurple}"
                   FontSize="22"/>

        </Grid>

        <!-- Центральная часть - для будущего списка привычек -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout>
                <Label Text="Список привычек"
                       FontFamily="RobotoRegular"
                       HorizontalOptions="Center"
                       TextColor="black"
                       FontSize="20"
                       Margin="0,20,0,0"/>
                <!-- Здесь будет ваш список привычек -->
                <!-- Например: -->
                <!-- <CollectionView> -->
                <!--     ваш список -->
                <!-- </CollectionView> -->
            </VerticalStackLayout>
        </ScrollView>

        <!-- Кнопка добавления привычки -->
        <Button Grid.Row="2"
                Text="Добавить новую привычку"
                FontFamily="RobotoLight"
                FontSize="20"
                BackgroundColor="{StaticResource PanelWhite}"
                TextColor="{StaticResource ActivePurple}"
                CornerRadius="10"
                HeightRequest="60"
                WidthRequest="293"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Margin="0,0,0,25">
            <!-- Отступ снизу 25px до панели навигации -->

            <Button.Shadow>
                <Shadow Brush="#40000000"
                        Offset="0,5"
                        Radius="2"
                        Opacity="0.3"/>
            </Button.Shadow>
        </Button>

        <!-- Панель навигации -->
        <Grid Grid.Row="3"
              BackgroundColor="{StaticResource PanelWhite}"
              HeightRequest="90"
              WidthRequest="412"
              Padding="20,0"
              ColumnDefinitions="*, *, *">

            <!-- Первая иконка -->
            <Button Grid.Column="0"
                    BackgroundColor="Transparent"
                    BorderWidth="0">
                <Button.ImageSource>
                    <FontImageSource Glyph="&#xE80F;"
                                     FontFamily="MaterialDesignIcons"
                                     Color="{StaticResource InactiveGrey}"
                                     Size="40"/>
                </Button.ImageSource>
            </Button>

            <!-- Вторая иконка -->
            <Button Grid.Column="1"
                    BackgroundColor="Transparent"
                    BorderWidth="0">
                <Button.ImageSource>
                    <FontImageSource Glyph="&#xE9D2;"
                                     FontFamily="MaterialDesignIcons"
                                     Color="{StaticResource ActivePurple}"
                                     Size="40"/>
                </Button.ImageSource>
            </Button>

            <!-- Третья иконка -->
            <Button Grid.Column="2"
                    BackgroundColor="Transparent"
                    BorderWidth="0">
                <Button.ImageSource>
                    <FontImageSource Glyph="&#xE853;"
                                     FontFamily="MaterialDesignIcons"
                                     Color="{StaticResource InactiveGrey}"
                                     Size="40"/>
                </Button.ImageSource>
            </Button>

        </Grid>

    </Grid>

</ContentPage>