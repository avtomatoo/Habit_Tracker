<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Habit_Tracker.CreatePage"
             Title="Новая привычка">

    <Grid RowDefinitions="Auto, *, Auto"
          Padding="30"
          RowSpacing="20">

        <!-- Заголовок -->
        <Label Grid.Row="0"
               Text="Создание привычки"
               FontFamily="RobotoRegular"
               HorizontalOptions="Center"
               TextColor="{StaticResource ActivePurple}"
               FontSize="24"
               Margin="0,20,0,0"/>

        <!-- Форма создания привычки -->
        <VerticalStackLayout Grid.Row="1"
                             Spacing="25"
                             VerticalOptions="Center">

            <!-- Поле названия привычки -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Название привычки"
                       FontFamily="RobotoRegular"
                       TextColor="Black"
                       FontSize="16"/>
                <Entry x:Name="HabitNameEntry"
                       Placeholder="Введите название привычки"
                       FontFamily="RobotoLight"
                       FontSize="16"
                       HeightRequest="50"
                       BackgroundColor="{StaticResource PanelWhite}"
                       TextColor="Black">
                    <Entry.Shadow>
                        <Shadow Brush="#20000000"
                                Offset="0,2"
                                Radius="1"
                                Opacity="0.2"/>
                    </Entry.Shadow>
                </Entry>
            </VerticalStackLayout>

            <!-- Выбор частоты напоминаний -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Частота напоминаний"
                       FontFamily="RobotoRegular"
                       TextColor="Black"
                       FontSize="16"/>

                <Picker x:Name="FrequencyPicker"
                        Title="Выберите частоту"
                        FontFamily="RobotoLight"
                        FontSize="16"
                        HeightRequest="50"
                        BackgroundColor="{StaticResource PanelWhite}"
                        TextColor="Black">
                    <Picker.Shadow>
                        <Shadow Brush="#20000000"
                                Offset="0,2"
                                Radius="1"
                                Opacity="0.2"/>
                    </Picker.Shadow>
                </Picker>
            </VerticalStackLayout>

            <!-- Время напоминания -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Время напоминания"
                       FontFamily="RobotoRegular"
                       TextColor="Black"
                       FontSize="16"/>
                <TimePicker x:Name="ReminderTimePicker"
                            FontFamily="RobotoLight"
                            FontSize="16"
                            HeightRequest="50">
                    <TimePicker.Shadow>
                        <Shadow Brush="#20000000"
                                Offset="0,2"
                                Radius="1"
                                Opacity="0.2"/>
                    </TimePicker.Shadow>
                </TimePicker>
            </VerticalStackLayout>

        </VerticalStackLayout>

        <!-- Кнопки -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*, *"
              ColumnSpacing="15"
              HeightRequest="60">

            <Button Grid.Column="0"
                    Text="Отмена"
                    FontFamily="RobotoLight"
                    FontSize="18"
                    BackgroundColor="{StaticResource PanelWhite}"
                    TextColor="{StaticResource ActivePurple}"
                    CornerRadius="10"
                    Clicked="OnCancelClicked">
                <Button.Shadow>
                    <Shadow Brush="#40000000"
                            Offset="0,5"
                            Radius="2"
                            Opacity="0.3"/>
                </Button.Shadow>
            </Button>

            <Button Grid.Column="1"
                    Text="Создать"
                    FontFamily="RobotoLight"
                    FontSize="18"
                    BackgroundColor="{StaticResource ActivePurple}"
                    TextColor="White"
                    CornerRadius="10"
                    Clicked="OnCreateClicked">
                <Button.Shadow>
                    <Shadow Brush="#40000000"
                            Offset="0,5"
                            Radius="2"
                            Opacity="0.3"/>
                </Button.Shadow>
            </Button>

        </Grid>

    </Grid>

</ContentPage>